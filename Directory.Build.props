<Project>
  <!-- Configuração comum a todos os projetos da solução. Ver docs/adr/0002-api-publica-e-nomenclatura.md. -->
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Authors>rcoliveira</Authors>
    <Copyright>Contém código portado de sqlparser-rs (Apache-2.0, The Apache Software Foundation). Ver NOTICE.</Copyright>
  </PropertyGroup>
</Project>
