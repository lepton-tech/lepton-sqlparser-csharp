<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Benchmark de desempenho: SqlParser.Core (port fiel do sqlparser-rs) + SqlParser (API pública)
    contra o SqlParser-cs. Fica FORA da solução (SqlParser.sln). Ver tools/bench/README.md.

    O SqlParser-cs vem de cópias do clone upstream/SqlParser-cs feitas por
    tools/bench/Prepare-SqlParserCs.ps1 (assembly renomeado para SqlParserCs.dll, porque o nosso
    src/SqlParser também gera SqlParser.dll). O caminho das cópias vem da propriedade (ou variável
    de ambiente) SqlParserCsDir.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net48</TargetFrameworks>
    <RootNamespace>SqlParser.Bench</RootNamespace>
    <AssemblyName>SqlParser.Bench</AssemblyName>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <IsPackable>false</IsPackable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <SqlParserCsDir Condition="'$(SqlParserCsDir)' == ''">$([System.IO.Path]::GetTempPath())SqlParser.Bench\sqlparser-cs</SqlParserCsDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\SqlParser.Core\SqlParser.Core.csproj" />
    <ProjectReference Include="..\..\..\src\SqlParser\SqlParser.csproj" />
  </ItemGroup>

  <!-- SqlParser-cs: cópia fiel (net8.0) ou a cópia com o patch do Plano B (netstandard2.0, para net48).
       O alias evita o conflito de nomes: os dois projetos usam o namespace SqlParser. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <ProjectReference Include="$(SqlParserCsDir)\net8\src\SqlParser\SqlParserCs.Net8.csproj" Aliases="SqlParserCs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <ProjectReference Include="$(SqlParserCsDir)\ns20\src\SqlParser\SqlParserCs.Ns20.csproj" Aliases="SqlParserCs" />
  </ItemGroup>

  <ItemGroup>
    <!-- As 22 consultas TPC-H dos testes (as mesmas de upstream/sqlparser-rs/tests/queries/tpch). -->
    <EmbeddedResource Include="..\..\..\tests\SqlParser.Core.Tests\Queries\tpch\*.sql" LogicalName="tpch.%(Filename).sql" />
  </ItemGroup>

</Project>
