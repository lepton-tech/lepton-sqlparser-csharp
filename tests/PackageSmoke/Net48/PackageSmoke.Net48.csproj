<Project Sdk="Microsoft.NET.Sdk">

  <!-- Consumidor .NET Framework 4.8 do pacote LeptonTech.SqlParser (fora da solução; tools/pack/Test-Package.ps1). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- C# 7.3, o padrão de projetos .NET Framework antigos (docs/adr/0006-versao-da-linguagem-csharp.md). -->
    <LangVersion>7.3</LangVersion>
    <RootNamespace>PackageSmoke</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LeptonTech.SqlParser" Version="$(LeptonTechSqlParserVersion)" />
  </ItemGroup>

</Project>
