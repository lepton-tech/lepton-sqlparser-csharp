<Project Sdk="Microsoft.NET.Sdk">

  <!-- Consumidor .NET 8 do pacote Lepton.SqlParser (fora da solução; tools/pack/Test-Package.ps1). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Mesmo Program.cs do app net48, em C# 7.3 (docs/adr/0006-versao-da-linguagem-csharp.md). -->
    <LangVersion>7.3</LangVersion>
    <RootNamespace>PackageSmoke</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lepton.SqlParser" Version="$(LeptonSqlParserVersion)" />
  </ItemGroup>

</Project>
