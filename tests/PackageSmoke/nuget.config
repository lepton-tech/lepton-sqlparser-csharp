<?xml version="1.0" encoding="utf-8"?>
<!--
  Fontes de pacote do teste do pacote: LeptonTech.* vem SÓ do feed local (artifacts/, gerado por
  tools/pack/Pack.ps1); o resto vem do nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="leptontech-local" value="../../artifacts" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="leptontech-local">
      <package pattern="LeptonTech.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
