<Project Sdk="Microsoft.NET.Sdk">

  <!-- Testes da API pública (código nosso). Testes portados do Rust ficam em SqlParser.Core.Tests. -->
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <RootNamespace>SqlParser.Tests</RootNamespace>
    <!-- net48: o Microsoft.Data.Sqlite depende de System.Memory em versões diferentes; sem binding redirects
         gerados no .config do teste, o carregamento falha com FileLoadException. -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <!-- Banco SQLite em memória para executar de verdade o SQL gerado (CenarioPaginacaoTests). Só nos testes. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <!-- net48: o SQLitePCLRaw pede System.Memory 4.0.5.0, mas o grafo resolveria a 4.5.3 (assembly 4.0.1.1). -->
    <PackageReference Include="System.Memory" Version="4.6.3" Condition="'$(TargetFramework)' == 'net48'" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SqlParser\SqlParser.csproj" />
    <!-- Referência explícita: o SqlParser referencia o Core com PrivateAssets=all (o Core vai dentro do pacote,
         não como dependência; docs/adr/0010-empacotamento.md), então o Core não chega aqui por transitividade. -->
    <ProjectReference Include="..\..\src\SqlParser.Core\SqlParser.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- shadowCopy=false: no .NET Framework, a cópia de sombra do xUnit deixaria para trás a DLL nativa do SQLite. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
